# --- Project Configuration ---
COMPOSE_PROJECT_NAME=eye
ENV=development
DOCKER_BIND_IP=127.0.0.1

# --- API Configuration ---
API_EXTERNAL_PORT=8000
API_INTERNAL_PORT=8000
CONTAINER_ROLE_API=api

# --- Worker Configuration ---
CONTAINER_ROLE_WORKER=worker
LLM_MAX_CONTEXT_TOKENS=2048
LLM_GPU_LAYERS=30

# --- Infrastructure ---
REDIS_EXTERNAL_PORT=6379
REDIS_INTERNAL_PORT=6379
REDIS_DSN=redis://redis-broker:6379/0

QDRANT_EXTERNAL_PORT=6333
QDRANT_INTERNAL_PORT=6333
QDRANT_URL=http://qdrant-db:6333

# --- API Keys & Secrets ---
# PEP_API_KEY=your_key_here
